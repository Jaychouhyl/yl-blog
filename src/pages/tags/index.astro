---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../config';
import { publishedPosts, allTags } from '../../lib/posts';
const tags = allTags(await publishedPosts());
---
<BaseLayout title="标签">
  <div class="container roomy" style="padding-top:110px;max-width:760px;">
    <p class="page-sub">TAGS</p>
    <h1 class="page-title">标签</h1>
    <p style="display:flex;flex-wrap:wrap;gap:10px;">
      {tags.map(([t, list]) => (
        <a class="chip" style="font-size:14px;padding:4px 14px;" href={withBase(`/tags/${t}/`)}>#{t} · {list.length}</a>
      ))}
    </p>
  </div>
</BaseLayout>
