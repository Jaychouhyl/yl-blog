---
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentPageLayout from '../../components/ContentPageLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { publishedPosts, allTags } from '../../lib/posts';

export async function getStaticPaths() {
  const tags = allTags(await publishedPosts());
  return tags.map(([tag, posts]) => ({ params: { tag }, props: { posts } }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { tag } = Astro.params;
const { posts } = Astro.props;
---
<BaseLayout title={`标签：${tag}`}>
  <ContentPageLayout>
    <section class="glass list-panel">
      <p class="page-sub">标签</p>
      <h1 class="page-title">#{tag}</h1>
      <div class="post-list">{posts.map((p) => <PostCard post={p} />)}</div>
    </section>
  </ContentPageLayout>
</BaseLayout>
<style>
  .list-panel { padding: 30px 34px 38px; }
  .post-list { display: flex; flex-direction: column; gap: 14px; margin-top: 24px; }
  @media (max-width: 520px) { .list-panel { padding: 24px 20px 30px; } }
</style>
