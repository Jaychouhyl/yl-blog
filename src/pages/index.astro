---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnnouncementWidget from '../components/AnnouncementWidget.astro';
import AvatarCard from '../components/AvatarCard.astro';
import PostCard from '../components/PostCard.astro';
import RecentPostsWidget from '../components/RecentPostsWidget.astro';
import SiteStats from '../components/SiteStats.astro';
import CommentSection from '../components/CommentSection.astro';
import { SITE, withBase } from '../config';
import { publishedPosts } from '../lib/posts';

const recent = (await publishedPosts()).slice(0, 5);
const heroImages = SITE.heroImages.map((image) => withBase(image));
const firstHeroImage = heroImages[0] ?? withBase('/hero.webp');
const heroLines = ['记录项目、琐碎、AI', '微服务、前端、后端、AI 学习琐碎'];
---
<BaseLayout>
  <section class="hero-screen" aria-labelledby="hero-title">
    <img
      class="hero-img"
      src={firstHeroImage}
      data-hero-image
      data-hero-images={JSON.stringify(heroImages)}
      alt=""
      fetchpriority="high"
      loading="eager"
      width="1920"
      height="1080"
    />
    <div class="hero-veil"></div>
    <div class="hero-content">
      <h1 id="hero-title">Yilin Blog</h1>
      <p class="hero-typewriter" data-typewriter data-lines={JSON.stringify(heroLines)}>
        <span data-typewriter-text>{heroLines[0]}</span>
      </p>
    </div>
    <button class="hero-down" aria-label="向下滚动查看内容">⌄</button>
    <div class="hero-wave" aria-hidden="true">
      <svg class="waves" viewBox="0 24 150 28" preserveAspectRatio="none">
        <defs><path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v48h-352z" /></defs>
        <g class="parallax">
          <use href="#gentle-wave" x="48" y="0" class="w1" />
          <use href="#gentle-wave" x="48" y="3" class="w2" />
          <use href="#gentle-wave" x="48" y="5" class="w3" />
          <use href="#gentle-wave" x="48" y="7" class="w4" />
        </g>
      </svg>
    </div>
  </section>

  <div class="container columns" id="home-content">
    <aside class="side">
      <AvatarCard />
      <AnnouncementWidget />
      <RecentPostsWidget limit={3} />
      <SiteStats />
    </aside>
    <div class="feed">
      {recent.map((post) => <PostCard post={post} />)}
      <a class="more muted" href={withBase('/posts/')}>查看全部文章 →</a>
      <CommentSection />
    </div>
  </div>
</BaseLayout>
<style>
  .hero-screen {
    position: relative;
    height: 100vh;
    height: 100svh;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    background: #000;
  }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 42% center; opacity: 0; transition: opacity 0.6s ease-out; }
  .hero-img.loaded { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .hero-img { transition: none; opacity: 1; } }
  .hero-veil {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at center, rgba(0,0,0,.68) 0%, rgba(0,0,0,.42) 28%, rgba(0,0,0,.12) 58%, rgba(0,0,0,0) 74%);
  }
  :global(html[data-theme='dark']) .hero-veil {
    background: radial-gradient(ellipse at center, rgba(0,0,0,.74) 0%, rgba(0,0,0,.48) 30%, rgba(0,0,0,.16) 60%, rgba(0,0,0,0) 76%);
  }
  .hero-content {
    position: absolute;
    z-index: 3;
    left: 50%;
    top: 47%;
    transform: translate(-50%, -50%);
    width: min(760px, calc(100vw - 40px));
    text-align: center;
    color: #fff;
  }
  .hero-content h1 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(46px, 6vw, 76px);
    line-height: 1.16;
    color: #fff;
  }
  .hero-typewriter {
    min-height: 1.8em;
    margin: 18px 0 0;
    color: rgba(255,255,255,.94);
    font-family: var(--serif);
    font-size: clamp(14px, 2vw, 24px);
    line-height: 1.8;
    white-space: nowrap;
  }
  .hero-typewriter span {
    display: inline-block;
    min-width: 1px;
    border-right: 2px solid rgba(255,255,255,.88);
    animation: caretBlink .8s steps(1) infinite;
  }
  @keyframes caretBlink { 50% { border-color: transparent; } }
  .hero-down {
    position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%);
    background: none; border: none; cursor: pointer; z-index: 3;
    color: #fff; font-size: 34px; line-height: 1; text-shadow: 0 2px 12px rgba(0,0,0,.4);
    animation: bob 2s ease-in-out infinite;
  }
  .hero-wave {
    position: absolute; left: 0; right: 0; bottom: -1px; z-index: 2;
    width: 100%; height: clamp(80px, 13vh, 150px); overflow: hidden;
  }
  .waves { width: 100%; height: 100%; min-height: 80px; }
  .parallax use { fill: var(--bg-paper); }
  .parallax .w1 { opacity: .5; animation: waveMove 8s cubic-bezier(.55,.5,.45,.5) -2s infinite; }
  .parallax .w2 { opacity: .35; animation: waveMove 11s cubic-bezier(.55,.5,.45,.5) -3s infinite; }
  .parallax .w3 { opacity: .2; animation: waveMove 14s cubic-bezier(.55,.5,.45,.5) -4s infinite; }
  .parallax .w4 { opacity: 1; animation: waveMove 22s cubic-bezier(.55,.5,.45,.5) -5s infinite; }
  @keyframes waveMove { 0% { transform: translate3d(-90px,0,0); } 100% { transform: translate3d(85px,0,0); } }
  @media (prefers-reduced-motion: reduce) { .parallax use { animation: none; } }
  @keyframes bob { 0%,100% { transform: translate(-50%, 0); } 50% { transform: translate(-50%, 10px); } }
  @media (prefers-reduced-motion: reduce) { .hero-down { animation: none; } }

  .columns { display: flex; gap: 22px; padding-top: 56px; padding-bottom: 80px; scroll-margin-top: var(--page-top); }
  .side { width: 230px; flex-shrink: 0; display: flex; flex-direction: column; gap: 16px; }
  .feed { flex: 1; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .more { text-align: center; padding: 8px; }
  @media (max-width: 768px) {
    .columns { flex-direction: column; }
    .side { width: 100%; }
    .hero-img { object-position: 42% center; }
    .hero-veil {
      background:
        linear-gradient(180deg, rgba(0,0,0,.44) 0%, rgba(0,0,0,.16) 38%, rgba(0,0,0,.58) 100%);
    }
    .hero-content { width: calc(100vw - 32px); }
  }
  @media (max-width: 420px) {
    .hero-content h1 { font-size: 42px; }
    .hero-typewriter { font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-typewriter span { animation: none; border-right: 0; }
  }
</style>
<script>
  const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let scrollLocked = false;

  const scrollToContent = () => {
    if (scrollLocked) return;
    scrollLocked = true;
    document.getElementById('home-content')?.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth' });
    window.setTimeout(() => { scrollLocked = false; }, prefersReduced ? 100 : 900);
  };

  document.querySelector('.hero-down')?.addEventListener('click', scrollToContent);
  window.addEventListener('wheel', (event) => {
    if (window.scrollY > 8 || event.deltaY <= 0 || scrollLocked) return;
    event.preventDefault();
    scrollToContent();
  }, { passive: false });

  const typewriter = document.querySelector<HTMLElement>('[data-typewriter]');
  const typewriterText = typewriter?.querySelector<HTMLElement>('[data-typewriter-text]');
  if (typewriter && typewriterText && !prefersReduced) {
    const lines = JSON.parse(typewriter.dataset.lines || '[]') as string[];
    let lineIndex = 0;
    let charIndex = Array.from(lines[0] || '').length;
    let deleting = true;

    const tick = () => {
      const chars = Array.from(lines[lineIndex] || '');
      charIndex += deleting ? -1 : 1;
      typewriterText.textContent = chars.slice(0, Math.max(0, charIndex)).join('');

      if (!deleting && charIndex >= chars.length) {
        deleting = true;
        window.setTimeout(tick, 1500);
        return;
      }
      if (deleting && charIndex <= 0) {
        deleting = false;
        lineIndex = (lineIndex + 1) % lines.length;
        window.setTimeout(tick, 420);
        return;
      }
      window.setTimeout(tick, deleting ? 58 : 105);
    };

    window.setTimeout(tick, 1500);
  }

  const heroImg = document.querySelector<HTMLImageElement>('[data-hero-image]');
  if (heroImg) {
    const showLoaded = () => heroImg.classList.add('loaded');
    const parseImages = () => {
      try {
        const value = JSON.parse(heroImg.dataset.heroImages || '[]');
        return Array.isArray(value) ? value.filter((item): item is string => typeof item === 'string' && item.length > 0) : [];
      } catch {
        return [];
      }
    };

    const images = parseImages();
    let current = 0;

    heroImg.dataset.currentHero = heroImg.currentSrc || heroImg.src;
    heroImg.addEventListener('load', showLoaded);
    if (heroImg.complete) showLoaded();

    const setHero = (index: number) => {
      const next = images[index];
      if (!next || heroImg.dataset.currentHero === next) return;
      current = index;
      heroImg.classList.remove('loaded');
      heroImg.dataset.currentHero = next;
      heroImg.src = next;
      if (heroImg.complete) requestAnimationFrame(showLoaded);
    };

    if (!prefersReduced && images.length > 1) {
      const start = Math.floor(Math.random() * images.length);
      setHero(start);
      const advance = () => setHero((current + 1) % images.length);
      let timer = setInterval(advance, 6000);
      document.addEventListener('visibilitychange', () => {
        clearInterval(timer);
        if (!document.hidden) timer = setInterval(advance, 6000);
      });
    }
  }
</script>
