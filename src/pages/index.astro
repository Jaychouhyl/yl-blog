---
import BaseLayout from '../layouts/BaseLayout.astro';
import AvatarCard from '../components/AvatarCard.astro';
import SiteStats from '../components/SiteStats.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, withBase } from '../config';
import { publishedPosts } from '../lib/posts';

const recent = (await publishedPosts()).slice(0, 5);
---
<BaseLayout>
  <section class="hero-screen">
    <img class="hero-img" src={withBase(SITE.heroImage)} alt="" fetchpriority="high" loading="eager" width="1920" height="1080" />
    <div class="hero-veil"></div>
    <button class="hero-down" aria-label="向下滚动查看内容">⌄</button>
    <div class="hero-wave" aria-hidden="true">
      <svg class="wave wave-back" viewBox="0 0 2880 100" preserveAspectRatio="none"><path d="M0,68 C180,90 540,90 720,68 C900,46 1260,46 1440,68 C1620,90 1980,90 2160,68 C2340,46 2700,46 2880,68 L2880,100 L0,100 Z" /></svg>
      <svg class="wave wave-front" viewBox="0 0 2880 100" preserveAspectRatio="none"><path d="M0,58 C180,34 540,34 720,58 C900,82 1260,82 1440,58 C1620,34 1980,34 2160,58 C2340,82 2700,82 2880,58 L2880,100 L0,100 Z" /></svg>
    </div>
  </section>

  <section class="intro container" id="home-content">
    <p class="page-sub">ESSAYS · PROJECTS · OTAKU LIFE — EST. 2026</p>
    <h1 class="intro-motto">{SITE.motto}</h1>
  </section>

  <div class="container columns">
    <aside class="side">
      <AvatarCard />
      <SiteStats />
    </aside>
    <div class="feed">
      {recent.map((post) => <PostCard post={post} />)}
      <a class="more muted" href={withBase('/posts/')}>查看全部随笔 →</a>
    </div>
  </div>
</BaseLayout>
<style>
  .hero-screen {
    position: relative;
    height: 100vh;
    height: 100svh;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.6s ease-out; }
  .hero-img.loaded { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .hero-img { transition: none; opacity: 1; } }
  .hero-veil {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,.20) 0%, rgba(0,0,0,0) 34%, rgba(0,0,0,.06) 74%, rgba(0,0,0,.16) 100%);
  }
  :global(html[data-theme='dark']) .hero-veil {
    background: linear-gradient(180deg, rgba(0,0,0,.40) 0%, rgba(0,0,0,.18) 34%, rgba(0,0,0,.30) 74%, rgba(0,0,0,.45) 100%);
  }
  /* 飛べ 图独占首屏；slogan 移到滚下来的纸色区做过渡 */
  .intro { text-align: center; padding: 60px 24px 0; }
  .intro-motto { font-size: clamp(28px, 4vw, 44px); margin: 10px 0 0; font-weight: 700; }
  .hero-down {
    position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%);
    background: none; border: none; cursor: pointer; z-index: 3;
    color: #fff; font-size: 34px; line-height: 1; text-shadow: 0 2px 12px rgba(0,0,0,.4);
    animation: bob 2s ease-in-out infinite;
  }
  .hero-wave {
    position: absolute; left: 0; right: 0; bottom: -1px; z-index: 2;
    width: 100%; height: clamp(72px, 9vw, 130px); overflow: hidden;
  }
  .wave { position: absolute; bottom: 0; left: 0; width: 200%; height: 100%; }
  .wave path { fill: var(--bg-paper); }
  .wave-back { opacity: .5; animation: waveX 15s linear infinite; }
  .wave-front { animation: waveX 10s linear infinite reverse; }
  @keyframes waveX { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .wave { animation: none; } }
  @keyframes bob { 0%,100% { transform: translate(-50%, 0); } 50% { transform: translate(-50%, 10px); } }
  @media (prefers-reduced-motion: reduce) { .hero-down { animation: none; } }

  .columns { display: flex; gap: 22px; padding-top: 40px; padding-bottom: 80px; }
  .side { width: 230px; flex-shrink: 0; display: flex; flex-direction: column; gap: 16px; }
  .feed { flex: 1; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .more { text-align: center; padding: 8px; }
  @media (max-width: 768px) {
    .columns { flex-direction: column; }
    .side { width: 100%; }
  }
</style>
<script>
  document.querySelector('.hero-down')?.addEventListener('click', () => {
    const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.getElementById('home-content')?.scrollIntoView({ behavior: (prefersReduced ? 'instant' : 'smooth') as ScrollBehavior });
  });

  const heroImg = document.querySelector<HTMLImageElement>('.hero-img');
  if (heroImg) {
    if (heroImg.complete) heroImg.classList.add('loaded');
    else heroImg.addEventListener('load', () => heroImg.classList.add('loaded'), { once: true });
  }
</script>
