---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../config';
import { allSeries, publishedPosts } from '../../lib/posts';

const seriesList = allSeries(await publishedPosts());
---
<BaseLayout title="内容专栏" description="按系列整理的长期写作入口。">
  <main class="container roomy series-page" style="padding-top:var(--page-top);max-width:820px;">
    <p class="page-sub">专栏</p>
    <h1 class="page-title">内容专栏</h1>
    <p class="lead muted">把同一主题下的文章串起来，方便按阶段阅读学习记录、项目复盘和站点建设笔记。</p>

    {seriesList.length > 0 ? (
      <div class="series-grid">
        {seriesList.map(([series, posts]) => (
          <a class="glass series-card" href={withBase(`/series/${series}/`)}>
            <span class="series-name">{series}</span>
            <span class="series-count">{posts.length} 篇</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="muted empty">暂无专栏。</p>
    )}
  </main>
</BaseLayout>

<style>
  .series-page {
    min-height: 68vh;
  }

  .lead {
    max-width: 560px;
    margin: 14px 0 0;
    line-height: 1.9;
  }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
    margin-top: 34px;
  }

  .series-card {
    display: grid;
    gap: 12px;
    min-height: 118px;
    padding: 20px;
    border-radius: 8px;
    color: var(--ink);
  }

  .series-card:hover {
    border-color: color-mix(in srgb, var(--sakura) 46%, var(--line));
    transform: translateY(-2px);
  }

  .series-name {
    font-size: 20px;
    font-weight: 700;
  }

  .series-count {
    align-self: end;
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 13px;
  }

  .empty {
    margin-top: 28px;
  }
</style>
