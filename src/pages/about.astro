---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, withBase } from '../config';
---
<BaseLayout title="关于">
  <div class="container roomy about-page" style="padding-top:var(--page-top);">
    <p class="page-sub">关于</p>
    <header class="about-head">
      <h1 class="page-title">关于我</h1>
      <p class="lead">待补充：站主确认后补入学校、经历、技能和研究方向。</p>
      {SITE.resumeUrl && <a class="resume-button" href={withBase(SITE.resumeUrl)}>下载简历 PDF</a>}
    </header>

    <section class="resume-section" aria-labelledby="position-heading">
      <h2 id="position-heading">一句话定位</h2>
      <!-- // 待站主填写真实信息：补充当前身份、方向和求职或复试场景。 -->
      <p>待站主填写：用一句话说明当前身份、关注方向和公开作品集用途。</p>
    </section>

    <section class="resume-section" aria-labelledby="education-heading">
      <h2 id="education-heading">教育背景</h2>
      <!-- // 待站主填写真实信息：学校、专业、时间等必须由站主确认后填写。 -->
      <dl class="resume-list">
        <div>
          <dt>学校 / 专业</dt>
          <dd>待站主填写。</dd>
        </div>
        <div>
          <dt>时间</dt>
          <dd>待站主填写。</dd>
        </div>
        <div>
          <dt>补充说明</dt>
          <dd>待站主填写。</dd>
        </div>
      </dl>
    </section>

    <section class="resume-section" aria-labelledby="skills-heading">
      <h2 id="skills-heading">技能栈</h2>
      <!-- // 待站主填写真实信息：只写能在面试中解释清楚的技能和熟悉程度。 -->
      <div class="skill-groups">
        <section aria-label="语言">
          <h3>语言</h3>
          <div class="skill-tags">
            <span>待站主填写</span>
          </div>
        </section>
        <section aria-label="框架与工具">
          <h3>框架与工具</h3>
          <div class="skill-tags">
            <span>待站主填写</span>
          </div>
        </section>
        <section aria-label="方向">
          <h3>方向</h3>
          <div class="skill-tags">
            <span>待站主填写</span>
          </div>
        </section>
      </div>
    </section>

    <section class="resume-section" aria-labelledby="research-heading">
      <h2 id="research-heading">研究兴趣</h2>
      <!-- // 待站主填写真实信息：研究兴趣、学习方向和材料边界都需要站主确认。 -->
      <p>待站主填写：后续只写站主本人确认过的学习方向、项目边界和可公开材料。</p>
    </section>

    <section class="resume-section" aria-labelledby="projects-heading">
      <h2 id="projects-heading">代表项目</h2>
      <div class="project-link">
        <a href={withBase('/projects/oracle-alpha/')}>OracleAlpha</a>
        <p>待站主补充真实项目边界、技术栈、负责内容和可展示材料。</p>
      </div>
    </section>

    <section class="resume-section" aria-labelledby="contact-heading">
      <h2 id="contact-heading">联系方式</h2>
      <dl class="resume-list">
        <div>
          <dt>GitHub</dt>
          <dd><a class="link" href={SITE.github} target="_blank" rel="noopener noreferrer">@Jaychouhyl</a></dd>
        </div>
        <div>
          <dt>邮箱</dt>
          <dd>待站主填写。</dd>
        </div>
      </dl>
    </section>
  </div>
</BaseLayout>
<style>
  .about-page { max-width: 820px; }
  .about-head {
    display: grid;
    gap: 12px;
    margin-bottom: 34px;
  }
  .lead {
    max-width: 720px;
    margin: 0;
    color: var(--ink-2);
    line-height: 1.85;
  }
  .resume-button {
    width: fit-content;
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--sakura);
    font-size: 14px;
  }
  .resume-button:hover { border-color: var(--sakura); }
  .resume-section {
    border-top: 1px solid var(--line);
    padding: 22px 0;
  }
  .resume-section h2 {
    margin: 0 0 12px;
    font-size: 22px;
  }
  .resume-section p {
    margin: 0;
    color: var(--ink-2);
    line-height: 1.85;
  }
  .resume-list {
    display: grid;
    gap: 14px;
    margin: 0;
  }
  .resume-list div {
    display: grid;
    gap: 4px;
  }
  .resume-list dt {
    color: var(--ink);
    font-weight: 700;
  }
  .resume-list dd {
    margin: 0;
    color: var(--ink-2);
  }
  .skill-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .skill-groups h3 {
    margin: 0 0 8px;
    color: var(--ink);
    font-size: 15px;
  }
  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .skill-tags span {
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink-2);
    font-size: 13px;
  }
  .project-link {
    display: grid;
    gap: 8px;
  }
  .project-link a,
  .link {
    color: var(--sakura);
  }
  @media (max-width: 680px) {
    .skill-groups { grid-template-columns: 1fr; }
  }
</style>
