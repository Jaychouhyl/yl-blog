---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---
<BaseLayout title="关于">
  <div class="container roomy" style="padding-top:var(--page-top);max-width:760px;">
    <p class="page-sub">关于</p>
    <h1 class="page-title">关于我</h1>
    <section class="bio" aria-labelledby="profile-heading">
      <h2 id="profile-heading">个人简介</h2>
      <p>
        你好，我是 {SITE.name}。这个站点用于整理公开写作、项目记录与长期复盘材料；涉及履历、技能和研究方向的具体事实，待站主核实后再补充。
      </p>

      <dl class="profile-list">
        <div>
          <dt>当前定位</dt>
          <dd>待补充：站主确认后补入学校、经历、技能和研究方向。</dd>
        </div>
        <div>
          <dt>关注方向</dt>
          <dd>待补充：后续只写站主本人确认过的学习方向、项目边界和可公开材料。</dd>
        </div>
        <div>
          <dt>项目与写作用途</dt>
          <dd>项目页用于记录问题背景、技术栈、实现思路和阶段计划；文章页用于沉淀学习过程、复盘结论和可持续更新的公开材料。</dd>
        </div>
        <div>
          <dt>联系方式</dt>
          <dd>
            GitHub：<a class="link" href={SITE.github} target="_blank" rel="noopener noreferrer">@Jaychouhyl</a>
          </dd>
        </div>
      </dl>
    </section>
  </div>
</BaseLayout>
<style>
  .bio { font-size: 16px; line-height: 1.9; color: var(--ink-2); }
  .bio h2 { margin: 0 0 14px; color: var(--ink); font-size: 22px; }
  .bio p { margin: 0 0 24px; }
  .profile-list { display: grid; gap: 18px; margin: 0; }
  .profile-list div { border-top: 1px solid var(--line); padding-top: 16px; }
  .profile-list dt { color: var(--ink); font-weight: 700; margin-bottom: 6px; }
  .profile-list dd { margin: 0; }
  .link { color: var(--sakura); }
</style>
