---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentPageLayout from '../../components/ContentPageLayout.astro';
import PageTitleHero from '../../components/PageTitleHero.astro';
import { withBase } from '../../config';
import { publishedPosts, groupByYear } from '../../lib/posts';
import { formatDate } from '../../lib/text';

const posts = await publishedPosts();
const byYear = groupByYear(posts);
---
<BaseLayout title="时间轴">
  <PageTitleHero title="时间轴" />
  <ContentPageLayout compactTop>
    <section class="glass timeline-panel">
      <p class="muted intro">按年份与日期查看全部 {posts.length} 篇公开文章。</p>
      <div class="archive-timeline">
        {byYear.map(([year, list]) => (
          <section class="timeline-year">
            <h2>{year}</h2>
            <ul>
              {list.map((post) => (
                <li>
                  <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date).slice(5)}</time>
                  <div class="timeline-entry">
                    <a href={withBase(`/posts/${post.id}/`)}>{post.data.title}</a>
                    {post.data.category && <a class="category" href={withBase(`/categories/${post.data.category}/`)}>{post.data.category}</a>}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>
  </ContentPageLayout>
</BaseLayout>
<style>
  .timeline-panel { padding: 30px 34px 38px; }
  .intro { margin: 0 0 28px; }
  .archive-timeline { position: relative; padding-left: 28px; }
  .archive-timeline::before { content: ''; position: absolute; left: 6px; top: 10px; bottom: 6px; width: 1px; background: color-mix(in srgb, var(--sakura) 55%, var(--line)); }
  .timeline-year { position: relative; }
  .timeline-year + .timeline-year { margin-top: 30px; }
  .timeline-year h2 { margin: 0 0 20px; font-size: 26px; }
  .timeline-year h2::before { content: ''; position: absolute; left: -28px; top: 10px; width: 13px; height: 13px; border: 3px solid var(--sakura); border-radius: 50%; background: var(--card); }
  .timeline-year ul { list-style: none; padding: 0; margin: 0; }
  .timeline-year li { position: relative; display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: 14px; padding: 0 0 22px; }
  .timeline-year li::before { content: ''; position: absolute; left: -26px; top: 8px; width: 8px; height: 8px; border: 2px solid var(--sakura); border-radius: 50%; background: var(--card); }
  .timeline-year time { color: var(--ink-3); font-family: var(--mono); font-size: 12px; }
  .timeline-entry { display: flex; align-items: flex-start; gap: 8px; min-width: 0; }
  .timeline-entry > a:first-child { font-family: var(--serif); line-height: 1.55; }
  .category { flex: 0 0 auto; padding: 1px 7px; border-radius: 99px; background: var(--sakura-soft); color: var(--sakura); font-size: 11px; }
  @media (max-width: 520px) {
    .timeline-panel { padding: 24px 20px 30px; }
    .timeline-year li { grid-template-columns: 45px minmax(0, 1fr); gap: 9px; }
    .timeline-entry { display: grid; gap: 5px; }
    .category { width: fit-content; }
  }
</style>
