---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../config';
import { publishedPosts, groupByYear, allTags } from '../../lib/posts';
import { formatDate } from '../../lib/text';

const posts = await publishedPosts();
const byYear = groupByYear(posts);
const tags = allTags(posts);
---
<BaseLayout title="随笔归档">
  <div class="container dense" style="padding-top:var(--page-top);max-width:760px;">
    <p class="page-sub">ARCHIVE</p>
    <h1 class="page-title">随笔归档</h1>
    <nav class="tag-cloud" aria-label="标签云">
      {tags.map(([t, list]) => (
        <a class="chip" href={withBase(`/tags/${t}/`)} aria-label={`${t} 标签，共 ${list.length} 篇`}>#{t} {list.length}</a>
      ))}
    </nav>
    {byYear.map(([year, list]) => (
      <section>
        <h2 class="year">{year}</h2>
        <ul class="timeline">
          {list.map((p) => (
            <li>
              <time class="muted date" datetime={formatDate(p.data.date)}>{formatDate(p.data.date).slice(5)/* MM-DD */}</time>
              <a class:list={['archive-link', { 'has-cover': p.data.cover }]} href={withBase(`/posts/${p.id}/`)}>
                {p.data.cover && (
                  <Image class="archive-cover" src={p.data.cover} alt="" width={72} height={48} densities={[1, 2]} loading="lazy" decoding="async" />
                )}
                <span>{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
<style>
  .tag-cloud { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 8px; }
  .year { font-size: 28px; border-bottom: 1px solid var(--line); padding-bottom: 6px; }
  .timeline { list-style: none; padding: 0; margin: 0; }
  .timeline li { display: flex; gap: 16px; padding: 7px 0; border-bottom: 1px dashed var(--line); }
  .date { font-family: var(--mono); flex-shrink: 0; }
  .archive-link { display: inline-flex; align-items: center; gap: 10px; min-width: 0; }
  .archive-cover {
    width: 72px; height: 48px; flex: 0 0 72px;
    object-fit: cover; border-radius: 6px;
    background: var(--sakura-soft);
  }
  @media (max-width: 520px) {
    .timeline li { gap: 10px; }
    .archive-cover { width: 58px; height: 38px; flex-basis: 58px; }
  }
</style>
