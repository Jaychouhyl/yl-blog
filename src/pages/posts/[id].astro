---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FloatingToc from '../../components/FloatingToc.astro';
import Giscus from '../../components/Giscus.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import { withBase } from '../../config';
import { allSeries, publishedPosts } from '../../lib/posts';
import { formatDate, readingMinutes } from '../../lib/text';
import '../../styles/prose.css';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  const seriesMap = new Map(allSeries(posts));
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      older: posts[i + 1] ?? null,
      newer: posts[i - 1] ?? null,
      seriesPosts: post.data.series ? seriesMap.get(post.data.series) ?? [] : [],
    },
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post, older, newer, seriesPosts } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---
<BaseLayout title={post.data.title} description={post.data.summary ?? post.data.title}>
  <ReadingProgress />
  <article class="container dense" style="padding-top:var(--page-top);max-width:760px;">
    <header class="head">
      <h1 class="page-title" style="font-size:clamp(28px,4vw,40px);">{post.data.title}</h1>
      <div class="meta muted">
        <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time> · 约 {readingMinutes(post.body ?? '')} 分钟 ·
        {post.data.category && <a class="chip" href={withBase(`/categories/${post.data.category}/`)}>分类：{post.data.category}</a>}
        {post.data.tags.map((t) => <a class="chip" href={withBase(`/tags/${t}/`)}>#{t}</a>)}
      </div>
    </header>
    {toc.length > 2 && <FloatingToc headings={toc} />}
    <div class="prose"><Content /></div>
    {post.data.series && <SeriesNav current={post} posts={seriesPosts} />}
    <nav class="pn" aria-label="文章导航">
      {older ? <a class="glass pn-card" href={withBase(`/posts/${older.id}/`)}>← {older.data.title}</a> : <span />}
      {newer ? <a class="glass pn-card" href={withBase(`/posts/${newer.id}/`)}>{newer.data.title} →</a> : <span />}
    </nav>
    <Giscus />
  </article>
</BaseLayout>
<style>
  .head { margin-bottom: 24px; }
  .meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 8px; }
  .pn { display: flex; justify-content: space-between; gap: 12px; margin: 40px 0 24px; }
  .pn-card { padding: 12px 16px; font-size: 14px; max-width: 48%; }
</style>
