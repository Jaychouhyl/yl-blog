---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSidebar from '../../components/ArticleSidebar.astro';
import ArticleTitleHero from '../../components/ArticleTitleHero.astro';
import ContentPageLayout from '../../components/ContentPageLayout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import { withBase } from '../../config';
import { allSeries, publishedPosts } from '../../lib/posts';
import { readingMinutes } from '../../lib/text';
import '../../styles/prose.css';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  const seriesMap = new Map(allSeries(posts));
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      older: posts[i + 1] ?? null,
      newer: posts[i - 1] ?? null,
      seriesPosts: post.data.series ? seriesMap.get(post.data.series) ?? [] : [],
    },
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post, older, newer, seriesPosts } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---
<BaseLayout title={post.data.title} description={post.data.summary ?? post.data.title}>
  <ReadingProgress />
  <ArticleTitleHero post={post} readingTime={readingMinutes(post.body ?? '')} />
  <ContentPageLayout compactTop>
  <ArticleSidebar slot="sidebar" headings={toc} />
  <article class="glass article-panel">
    <div class="prose"><Content /></div>
    {post.data.series && <SeriesNav current={post} posts={seriesPosts} />}
    <nav class="pn" aria-label="文章导航">
      {older ? <a class="glass pn-card" href={withBase(`/posts/${older.id}/`)}>← {older.data.title}</a> : <span />}
      {newer ? <a class="glass pn-card" href={withBase(`/posts/${newer.id}/`)}>{newer.data.title} →</a> : <span />}
    </nav>
  </article>
  </ContentPageLayout>
</BaseLayout>
<style>
  .article-panel { padding: 30px 34px 38px; }
  .pn { display: flex; justify-content: space-between; gap: 12px; margin: 40px 0 24px; }
  .pn-card { padding: 12px 16px; font-size: 14px; max-width: 48%; }
  @media (max-width: 520px) { .article-panel { padding: 24px 20px 30px; } }
</style>
