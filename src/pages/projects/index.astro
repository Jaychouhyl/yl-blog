---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const rendered = await Promise.all(projects.map(async (p) => ({ p, Content: (await render(p)).Content })));
---
<BaseLayout title="项目">
  <div class="container roomy" style="padding-top:var(--page-top);">
    <p class="page-sub">项目</p>
    <h1 class="page-title">项目</h1>
    <p class="intro">这里整理适合公开展示的个人项目：优先说明项目定位、技术栈、当前进度和后续计划，避免把建设中的工作包装成已经完成的成果。</p>
    <div class="grid" aria-label="项目作品集">
      {rendered.map(({ p, Content }) => (
        <article class="glass card">
          <header class="card-head">
            <p class="eyebrow">公开项目</p>
            <h2 class="name">{p.data.title}</h2>
            <dl class="project-meta" aria-label={`${p.data.title} 项目元信息`}>
              <div>
                <dt>当前状态</dt>
                <dd>{p.data.status}</dd>
              </div>
              {p.data.audience.length > 0 && (
                <div>
                  <dt>适用场景</dt>
                  <dd>{p.data.audience.join(' / ')}</dd>
                </div>
              )}
            </dl>
          </header>
          {p.data.tech.length > 0 && (
            <section class="block" aria-label={`${p.data.title} 技术栈`}>
              <h3>技术栈</h3>
              <div class="tech">{p.data.tech.map((t) => <span class="chip">{t}</span>)}</div>
            </section>
          )}
          <section class="block">
            <h3>项目说明</h3>
            <div class="desc"><Content /></div>
          </section>
          {p.data.repo && (
            <a class="repo" href={p.data.repo} target="_blank" rel="noopener noreferrer" aria-label={`${p.data.title} 项目链接`}>
              项目链接 →
            </a>
          )}
        </article>
      ))}
    </div>
    {rendered.length === 0 && <p class="muted" style="margin-top:24px;">暂无项目。</p>}
  </div>
</BaseLayout>
<style>
  .intro { max-width: 760px; margin: 12px 0 0; color: var(--ink-2); line-height: 1.8; }
  .grid { display: grid; grid-template-columns: minmax(0, 760px); gap: 20px; margin-top: 28px; }
  .card { display: flex; flex-direction: column; gap: 18px; padding: 26px 28px; }
  .card-head { border-bottom: 1px solid var(--line); padding-bottom: 14px; }
  .eyebrow { margin: 0 0 6px; color: var(--ink-3); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
  .name { margin: 0; font-size: 24px; }
  .project-meta { display: flex; flex-wrap: wrap; gap: 10px 18px; margin: 14px 0 0; }
  .project-meta div { display: grid; gap: 3px; min-width: 120px; }
  .project-meta dt { color: var(--ink-3); font-size: 12px; }
  .project-meta dd { margin: 0; color: var(--ink-2); font-size: 13px; }
  .block h3 { margin: 0 0 8px; font-size: 15px; }
  .tech { display: flex; gap: 6px; flex-wrap: wrap; }
  .desc { color: var(--ink-2); font-size: 14px; line-height: 1.8; }
  .desc :global(h2) { margin: 1.1em 0 0.35em; color: var(--ink); font-size: 16px; }
  .desc :global(h2:first-child) { margin-top: 0; }
  .desc :global(h3) { margin: 1em 0 0.3em; color: var(--ink); font-size: 14px; }
  .desc :global(p) { margin: 0.45em 0; }
  .desc :global(ul) { margin: 0.45em 0 0.75em; padding-left: 1.2em; }
  .repo { align-self: flex-start; color: var(--sakura); font-size: 14px; }
</style>
