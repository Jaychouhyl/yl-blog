---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentPageLayout from '../../components/ContentPageLayout.astro';
import { withBase } from '../../config';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
---
<BaseLayout title="项目">
  <ContentPageLayout>
  <section class="glass projects-panel">
    <p class="page-sub">项目</p>
    <h1 class="page-title">项目作品集</h1>
    <p class="intro">这里整理适合公开展示的个人项目：优先说明项目定位、技术栈、当前进度和后续计划，避免把建设中的工作包装成已经完成的成果。</p>
    <div class="portfolio-grid" aria-label="项目作品集">
      {projects.map((p) => (
        <a class:list={['glass', 'portfolio-card', { 'has-cover': p.data.cover }]} href={withBase(`/projects/${p.id}/`)}>
          {p.data.cover && (
            <Image
              class="project-cover"
              src={p.data.cover}
              alt=""
              width={220}
              height={140}
              densities={[1, 2]}
              loading="lazy"
              decoding="async"
            />
          )}
          <div class="card-body">
            <div class="card-head">
              <p class="eyebrow">公开项目</p>
              {p.data.featured && <span class="featured-mark">精选</span>}
              <h2 class="name">{p.data.title}</h2>
            </div>
            {p.data.summary && <p class="summary">{p.data.summary}</p>}
            <dl class="project-meta" aria-label={`${p.data.title} 项目元信息`}>
              <div>
                <dt>当前状态</dt>
                <dd>{p.data.status}</dd>
              </div>
              {p.data.audience.length > 0 && (
                <div>
                  <dt>适用场景</dt>
                  <dd>{p.data.audience.join(' / ')}</dd>
                </div>
              )}
              {p.data.role && (
                <div>
                  <dt>角色</dt>
                  <dd>{p.data.role}</dd>
                </div>
              )}
              {p.data.period && (
                <div>
                  <dt>周期</dt>
                  <dd>{p.data.period}</dd>
                </div>
              )}
            </dl>
            {p.data.tech.length > 0 && (
              <div class="tech" aria-label={`${p.data.title} 技术栈`}>
                {p.data.tech.map((tech) => <span class="chip">{tech}</span>)}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
    {projects.length === 0 && <p class="muted" style="margin-top:24px;">暂无项目。</p>}
  </section>
  </ContentPageLayout>
</BaseLayout>
<style>
  .projects-panel { padding: 30px 34px 38px; }
  .intro { max-width: 760px; margin: 12px 0 0; color: var(--ink-2); line-height: 1.8; }
  .portfolio-grid {
    display: grid;
    grid-template-columns: minmax(0, 820px);
    gap: 18px;
    margin-top: 28px;
  }
  .portfolio-card {
    display: flex;
    gap: 18px;
    padding: 22px 24px;
    border-radius: 8px;
    transition: transform 0.2s, border-color 0.2s;
  }
  .portfolio-card:hover {
    transform: translateY(-2px);
    border-color: var(--sakura);
    color: inherit;
  }
  .project-cover {
    width: 220px;
    height: 140px;
    flex: 0 0 220px;
    object-fit: cover;
    border-radius: 8px;
    background: var(--sakura-soft);
  }
  .card-body {
    min-width: 0;
    display: grid;
    gap: 12px;
  }
  .card-head { border-bottom: 1px solid var(--line); display: grid; gap: 4px; padding-bottom: 10px; }
  .eyebrow { margin: 0; color: var(--ink-3); font-size: 12px; font-weight: 600; }
  .featured-mark { width: fit-content; color: var(--sakura); font-size: 12px; }
  .name { margin: 0; font-size: 24px; }
  .summary { margin: 0; color: var(--ink-2); line-height: 1.75; }
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin: 0;
  }
  .project-meta div { display: grid; gap: 3px; min-width: 110px; }
  .project-meta dt { color: var(--ink-3); font-size: 12px; }
  .project-meta dd { margin: 0; color: var(--ink-2); font-size: 13px; }
  .tech { display: flex; gap: 6px; flex-wrap: wrap; }
  @media (prefers-reduced-motion: reduce) {
    .portfolio-card { transition: none; }
    .portfolio-card:hover { transform: none; }
  }
  @media (max-width: 680px) {
    .projects-panel { padding: 24px 20px 30px; }
    .portfolio-card { flex-direction: column; padding: 18px; }
    .project-cover { width: 100%; height: auto; aspect-ratio: 16 / 9; flex-basis: auto; }
  }
</style>
