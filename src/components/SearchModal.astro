<dialog id="search-modal" aria-labelledby="search-title">
  <header class="search-head">
    <h2 id="search-title">搜索站内内容</h2>
    <button id="search-close" class="search-close" type="button" aria-label="关闭搜索">×</button>
  </header>
  <div id="search-box"></div>
  <p class="muted hint" id="search-hint" hidden>搜索索引仅在构建产物中可用：先 npm run build && npm run preview</p>
</dialog>
<style>
  #search-modal {
    width: min(640px, 92vw); margin: 10vh auto 0;
    border: 1px solid var(--card-border); border-radius: 8px; padding: 18px;
    background: var(--bg-paper); color: var(--ink);
    --pagefind-ui-background: var(--card);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-primary: var(--sakura);
    --pagefind-ui-tag: var(--sakura-soft);
  }
  #search-modal::backdrop { background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(2px); }
  .search-head {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    margin-bottom: 12px; padding-bottom: 10px; border-bottom: 1px solid var(--line);
  }
  .search-head h2 {
    margin: 0; font-size: 18px;
  }
  .search-close {
    width: 32px; height: 32px; flex: 0 0 auto;
    border: 1px solid var(--line); border-radius: 50%;
    background: var(--card); color: var(--ink); cursor: pointer;
    font: inherit; font-size: 20px; line-height: 1;
  }
  .search-close:hover { color: var(--sakura); border-color: var(--sakura); }
  .hint { text-align: center; }
</style>
<script>
  import { withBase } from '../config';
  const modal = document.getElementById('search-modal') as HTMLDialogElement;
  const closeButton = document.getElementById('search-close') as HTMLButtonElement | null;
  const hint = document.getElementById('search-hint')!;
  let loaded = false;

  async function openSearch() {
    modal.showModal();
    if (loaded) return;
    loaded = true;
    const css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = withBase('/pagefind/pagefind-ui.css');
    css.onerror = () => { hint.hidden = false; };
    document.head.appendChild(css);
    const js = document.createElement('script');
    js.src = withBase('/pagefind/pagefind-ui.js');
    js.onload = () => {
      // @ts-expect-error PagefindUI 由外部脚本注入
      new PagefindUI({ element: '#search-box', showSubResults: true, translations: { placeholder: '搜索文章…' } });
      (document.querySelector('#search-box input') as HTMLInputElement | null)?.focus();
    };
    js.onerror = () => { hint.hidden = false; };
    document.body.appendChild(js);
  }

  document.getElementById('search-btn')?.addEventListener('click', openSearch);
  closeButton?.addEventListener('click', () => modal.close());
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (modal.open) { modal.close(); } else { openSearch(); }
    }
  });
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
</script>
