---
import { publishedPosts, allTags } from '../lib/posts';
import { countWords } from '../lib/text';
import { SITE } from '../config';
import Widget from './Widget.astro';

const posts = await publishedPosts();
// allTags 返回 [tagName, posts[]] 元组数组，.length 即唯一标签数
const tagCount = allTags(posts).length;
const totalWords = posts.reduce((sum, p) => sum + countWords(p.body ?? ''), 0);
---
<Widget title="站点数据">
  <div class="card">
    <div class="row"><span>📄 文章</span><b>{posts.length}</b></div>
    <div class="row"><span>🏷 标签</span><b>{tagCount}</b></div>
    <div class="row"><span>✑ 总字数</span><b>{totalWords.toLocaleString()}</b></div>
    <div class="row" id="pv-row" hidden>
      <span>👀 全站浏览</span><b id="busuanzi_value_site_pv"></b>
    </div>
    <div class="row"><span>⏳ 运行时长</span><b id="run-days" data-start={SITE.startDate}></b></div>
  </div>
</Widget>
<style>
  .row { display: flex; justify-content: space-between; padding: 5px 0; border-bottom: 1px dashed var(--line); color: var(--ink-2); }
  .row:last-child { border-bottom: none; }
</style>
<script>
  const el = document.getElementById('run-days')!;
  const days = Math.floor((Date.now() - new Date(el.dataset.start!).getTime()) / 86400000);
  el.textContent = `${Math.max(0, days)} 天`;
  // 不蒜子脚本由生产构建注入（Task 14）；取到数字才显示该行
  const pvRow = document.getElementById('pv-row')!;
  const pv = document.getElementById('busuanzi_value_site_pv')!;
  const timer = setInterval(() => {
    if (pv.textContent && pv.textContent.trim() !== '') {
      pvRow.hidden = false;
      clearInterval(timer);
    }
  }, 500);
  setTimeout(() => clearInterval(timer), 8000);
</script>
