---
import { SITE, withBase } from '../config';
import { allCategories, allTags, publishedPosts } from '../lib/posts';
import Widget from './Widget.astro';

const posts = await publishedPosts();
const stats = {
  posts: posts.length,
  tags: allTags(posts).length,
  categories: allCategories(posts).length,
};
---
<Widget title="忆霖 · 个人站">
  <div class="card">
    <img class="avatar" src={withBase('/avatar.png')} alt="个人头像" width="84" height="84" />
    <div class="name">{SITE.name}</div>
    <div class="muted">项目 · 琐碎 · AI</div>
    <div class="stats" aria-label="站点内容数量">
      <div><b>{stats.posts}</b><span>文章</span></div>
      <div><b>{stats.tags}</b><span>标签</span></div>
      <div><b>{stats.categories}</b><span>分类</span></div>
    </div>
    <a class="follow" href={SITE.github} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.29-5.27-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18A10.98 10.98 0 0 1 12 6.13c.98 0 1.96.13 2.88.39 2.19-1.49 3.15-1.18 3.15-1.18.63 1.58.23 2.75.12 3.04.73.8 1.17 1.83 1.17 3.08 0 4.4-2.71 5.38-5.29 5.67.42.36.78 1.07.78 2.16v3.26c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
      </svg>
      <span>Follow Me</span>
    </a>
  </div>
</Widget>
<style>
  .card { text-align: center; }
  .avatar { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; margin: 0 auto;
    border: 3px solid var(--card-border); box-shadow: var(--shadow); }
  .name { font-family: var(--serif); font-size: 18px; margin-top: 10px; }
  .stats {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px;
    margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line);
  }
  .stats div { display: grid; gap: 2px; }
  .stats b { font-family: var(--serif); font-size: 18px; color: var(--ink); }
  .stats span { color: var(--ink-3); font-size: 11px; }
  .follow {
    min-height: 38px; display: flex; align-items: center; justify-content: center; gap: 8px;
    margin-top: 16px; border-radius: 7px; background: var(--sakura); color: #fff;
  }
  .follow:hover { color: #fff; opacity: .88; }
  .follow svg { width: 17px; height: 17px; fill: currentColor; }
</style>
