---
import { SITE, withBase } from '../config';
const current = Astro.url.pathname;
---
<nav class="glass nav">
  <a class="brand" href={withBase('/')}>{SITE.name}<span class="dot">·</span>小筑</a>
  {SITE.nav.map((item) => (
    <a class:list={['link', { active: current === withBase(item.href) }]} href={withBase(item.href)}>{item.label}</a>
  ))}
  <span class="sep">|</span>
  <button id="search-btn" class="icon-btn" title="搜索 (Ctrl+K)" aria-label="搜索">🔍</button>
  <button id="theme-btn" class="icon-btn" aria-label="切换深浅色"></button>
</nav>
<style>
  .nav {
    position: fixed; top: 18px; left: 50%; transform: translateX(-50%);
    display: flex; align-items: center; gap: 20px;
    padding: 10px 26px; border-radius: 99px; z-index: 100;
    font-size: 14px; white-space: nowrap;
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  .brand { font-family: var(--serif); font-size: 17px; }
  .dot { color: var(--sakura); }
  .link { color: var(--ink-2); }
  .link.active, .link:hover { color: var(--ink); }
  .sep { color: var(--line); }
  .icon-btn { background: none; border: none; cursor: pointer; font-size: 15px; padding: 0; }
  :global(html[data-theme='light']) #theme-btn::before { content: '🌙'; }
  :global(html[data-theme='dark']) #theme-btn::before { content: '☀️'; }
  .nav::-webkit-scrollbar { display: none; }
  @media (max-width: 768px) {
    .nav { gap: 12px; padding: 8px 16px; font-size: 13px; max-width: 94vw; overflow-x: auto; scrollbar-width: none; }
  }
  .nav { transition: background .3s, box-shadow .3s, backdrop-filter .3s; }
  .nav.transparent {
    background: transparent;
    backdrop-filter: none; -webkit-backdrop-filter: none;
    border-color: transparent; box-shadow: none;
  }
  .nav.transparent .brand,
  .nav.transparent .link,
  .nav.transparent .icon-btn {
    color: #fff; text-shadow: 0 1px 8px rgba(0,0,0,.4);
  }
  .nav.transparent .link:hover { color: #ffd9e2; }
</style>
<script>
  document.getElementById('theme-btn')!.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
    html.dataset.theme = next;
    localStorage.setItem('theme', next);
  });

  const hero = document.querySelector('.hero-screen');
  const navEl = document.querySelector('nav.nav');
  if (hero && navEl) {
    const io = new IntersectionObserver(
      ([e]) => navEl.classList.toggle('transparent', e.isIntersecting && e.intersectionRatio > 0.15),
      { threshold: [0, 0.15, 0.5], rootMargin: '-70px 0px 0px 0px' }
    );
    io.observe(hero);
  }
</script>
