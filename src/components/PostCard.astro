---
import { Image } from 'astro:assets';
import { withBase } from '../config';
import { formatDate, readingMinutes } from '../lib/text';
import type { Post } from '../lib/posts';

interface Props { post: Post; }
const { post } = Astro.props;
---
<a class:list={['glass', 'card', { 'has-cover': post.data.cover }]} href={withBase(`/posts/${post.id}/`)}>
  {post.data.cover && (
    <Image
      class="cover"
      src={post.data.cover}
      alt=""
      width={160}
      height={108}
      densities={[1, 2]}
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="body">
    <h2 class="title">{post.data.title}</h2>
    {post.data.summary && <p class="muted summary">{post.data.summary}</p>}
    <div class="meta">
      {post.data.tags.map((t) => <span class="chip">#{t}</span>)}
      <span class="muted">{formatDate(post.data.date)} · 约 {readingMinutes(post.body ?? '')} 分钟</span>
    </div>
  </div>
</a>
<style>
  .card { display: flex; gap: 14px; padding: 18px 22px; transition: transform 0.2s, box-shadow 0.2s; }
  .card:hover { transform: translateY(-2px); color: inherit; }
  .body { min-width: 0; flex: 1; }
  .cover {
    width: 160px; height: 108px; flex: 0 0 160px;
    object-fit: cover; border-radius: 8px;
    background: var(--sakura-soft);
  }
  .title { font-family: var(--serif); font-size: 17px; margin: 0; }
  .summary { margin: 6px 0 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .meta { margin-top: 10px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  @media (max-width: 640px) {
    .card { flex-direction: column; padding: 16px; }
    .cover { width: 100%; height: auto; aspect-ratio: 16 / 9; flex-basis: auto; }
  }
</style>
