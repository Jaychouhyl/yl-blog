---
interface GraphNode {
  id: string;
  title: string;
  type: 'post' | 'tag';
  href: string;
  size: number;
}

interface GraphLink {
  source: string;
  target: string;
  value: number;
}

interface Props {
  graph: {
    nodes: GraphNode[];
    links: GraphLink[];
  };
}

const { graph } = Astro.props;
---
<section class="glass graph-shell" data-graph-root data-graph={JSON.stringify(graph)}>
  <div class="graph-head">
    <div>
      <p class="page-sub">GRAPH</p>
      <h2>文章关系图谱</h2>
    </div>
    <div class="graph-stats">
      <span>{graph.nodes.length} nodes</span>
      <span>{graph.links.length} links</span>
    </div>
  </div>
  <div class="graph-canvas" data-graph-canvas aria-label="文章与标签关系图谱"></div>
  <div class="graph-legend" aria-label="图例">
    <span><i class="post-dot"></i>文章</span>
    <span><i class="tag-dot"></i>标签</span>
  </div>
</section>
<script src="../scripts/graph.ts"></script>
<style>
  .graph-shell {
    padding: 24px;
    border-radius: 8px;
    overflow: hidden;
  }
  .graph-head {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 18px;
    margin-bottom: 14px;
  }
  .graph-head h2 {
    margin: 2px 0 0;
    font-size: clamp(24px, 4vw, 36px);
  }
  .graph-stats {
    display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end;
    color: var(--ink-3); font-family: var(--mono); font-size: 12px;
  }
  .graph-stats span {
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .graph-canvas {
    position: relative;
    min-height: 520px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      radial-gradient(circle at 22% 18%, color-mix(in srgb, var(--sakura-soft) 52%, transparent), transparent 28%),
      linear-gradient(180deg, color-mix(in srgb, var(--card) 72%, transparent), transparent);
  }
  .graph-canvas:empty::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 42px 42px;
    opacity: 0.24;
  }
  .graph-canvas :global(svg) {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    min-height: 520px;
    display: block;
  }
  .graph-shell :global(.graph-link) {
    stroke: color-mix(in srgb, var(--ink-3) 46%, transparent);
    stroke-width: 1.2;
  }
  .graph-shell :global(.graph-node) {
    cursor: pointer;
  }
  .graph-shell :global(.graph-node circle) {
    stroke: var(--card);
    stroke-width: 3;
    filter: drop-shadow(0 8px 16px rgb(22 27 34 / 0.12));
  }
  .graph-shell :global(.graph-node-post circle) { fill: var(--sakura); }
  .graph-shell :global(.graph-node-tag circle) { fill: var(--warm); }
  .graph-shell :global(.graph-node text) {
    fill: var(--ink-2);
    font-family: var(--sans);
    font-size: 12px;
    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--bg-paper);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .graph-legend {
    display: flex; gap: 14px; align-items: center; flex-wrap: wrap;
    margin-top: 12px;
    color: var(--ink-3);
    font-size: 12px;
  }
  .graph-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .graph-legend i {
    width: 9px; height: 9px;
    border-radius: 50%;
    display: inline-block;
  }
  .post-dot { background: var(--sakura); }
  .tag-dot { background: var(--warm); }
  @media (max-width: 680px) {
    .graph-shell { padding: 18px; }
    .graph-head { flex-direction: column; }
    .graph-stats { justify-content: flex-start; }
    .graph-canvas { min-height: 380px; }
    .graph-canvas :global(svg) { min-height: 380px; }
  }
</style>
