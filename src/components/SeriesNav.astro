---
import { withBase } from '../config';
import type { Post } from '../lib/posts';

interface Props {
  current: Post;
  posts: Post[];
}

const { current, posts } = Astro.props;
const series = current.data.series;
---
{series && posts.length > 0 && (
  <section class="glass series-nav" aria-labelledby="series-nav-title">
    <div class="series-head">
      <p class="eyebrow">内容专栏</p>
      <h2 id="series-nav-title">{series}</h2>
    </div>
    <ol>
      {posts.map((post) => (
        <li>
          <a
            class:list={['series-item', { current: post.id === current.id }]}
            href={withBase(`/posts/${post.id}/`)}
            aria-current={post.id === current.id ? 'page' : undefined}
          >
            <span class="order">{post.data.seriesOrder ? `第 ${post.data.seriesOrder} 篇` : '未排序'}</span>
            <span>{post.data.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
)}
<style>
  .series-nav {
    margin: 34px 0 0;
    padding: 20px 22px;
    border-radius: 8px;
  }
  .series-head {
    display: grid;
    gap: 3px;
    margin-bottom: 12px;
  }
  .eyebrow {
    margin: 0;
    color: var(--ink-3);
    font-size: 12px;
  }
  h2 {
    margin: 0;
    font-size: 20px;
  }
  ol {
    display: grid;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .series-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--ink-2);
  }
  .series-item:hover,
  .series-item.current {
    background: var(--sakura-soft);
    color: var(--sakura);
  }
  .order {
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 12px;
  }
  .series-item.current .order {
    color: var(--sakura);
  }
</style>
